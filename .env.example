# =============================================================================
# .env.example — nm-services NestJS Monorepo
# Copia a .env y ajusta los valores antes de correr los servicios.
# =============================================================================

# ── Entorno ──────────────────────────────────────────────────────────────────
NODE_ENV=development
FRONTEND_URL=http://localhost:4200

# ── Base de datos ─────────────────────────────────────────────────────────────
POSTGRES_DB=nm_services
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_PORT=5433
DATABASE_URL=postgresql://postgres:password@localhost:5433/nm_services

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Colas BullMQ (global — cualquier microservicio puede usar @app/queue-manager)
QUEUE_ENABLED=true
QUEUE_CONCURRENCY=5
QUEUE_ATTEMPTS=3
QUEUE_BACKOFF_MS=5000
QUEUE_REMOVE_ON_COMPLETE=200
QUEUE_REMOVE_ON_FAIL=500

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIA_ESTO_POR_UN_SECRET_DE_64_CHARS_MINIMO
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CAMBIA_ESTE_TAMBIEN_POR_UN_SECRET_DIFERENTE_64_CHARS
JWT_REFRESH_EXPIRES_IN=7d

# ── Rate Limiting ─────────────────────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=120

# ── Puertos internos (Docker usa estos para enrutar entre servicios) ──────────
GATEWAY_PORT=3000
AUTH_SERVICE_URL=http://localhost:3001
CATALOG_SERVICE_URL=http://localhost:3002
INVENTORY_SERVICE_URL=http://localhost:3003
POS_SERVICE_URL=http://localhost:3004
FINANCE_SERVICE_URL=http://localhost:3005
HR_SERVICE_URL=http://localhost:3006
REPORT_SERVICE_URL=http://localhost:3007
DOCUMENT_SERVICE_URL=http://localhost:3011
STORAGE_SERVICE_URL=http://localhost:3008
ECOMMERCE_SERVICE_URL=http://localhost:3012
MAIL_SERVICE_URL=http://localhost:3013
CHATBOT_SERVICE_URL=http://localhost:8090
HEADER_CACHE_TTL_SECONDS=300

# ── SUNAT / Greenter (proxy al nm-backend legacy durante transición) ──────────
SUNAT_BACKEND_URL=http://localhost:8000
SUNAT_BACKEND_API_KEY=
# Token apis.net.pe para consulta DNI/RUC (mismo valor que SUNAT_TOKEN en nm-backend Laravel)
SUNAT_TOKEN=

# ── Integraciones externas ────────────────────────────────────────────────────
# ── Storage Service ───────────────────────────────────────────────────────────
# STORAGE_DRIVER: local | firebase
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=./storage/uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:3000/api/v1/storage/files
STORAGE_SERVICE_KEY=nm-storage-dev-key-change-in-production

# Document Service (renderizado PDF/Excel — service-to-service)
DOCUMENT_SERVICE_KEY=nm-document-dev-key-change-in-production
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser

# Mail Service (Zoho Mail SMTP — service-to-service)
MAIL_SERVICE_KEY=nm-mail-dev-key-change-in-production
MAIL_SERVICE_ENABLED=true
MAIL_FROM_NAME=Novedades Maritex
MAIL_FROM_EMAIL=
# Cuenta Zoho Mail (correo completo, ej. ventas@tudominio.com)
ZOHO_USER=
# Contraseña de aplicación: Zoho Mail → Configuración → Seguridad → Contraseñas de aplicación
ZOHO_APP_PASSWORD=
# SMTP (por defecto smtp.zoho.com:465; usar 587 si tu cuenta lo requiere)
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_PORT=465
# URL pública del storefront nm-ecommerce
ECOMMERCE_STORE_URL=http://localhost:3001
# Branding de correos (basado en templates nm-email / Multikart)
MAIL_LOGO_URL=
MAIL_BANNER_URL=
MAIL_SUPPORT_EMAIL=
MAIL_SOCIAL_FACEBOOK=
MAIL_SOCIAL_INSTAGRAM=
MAIL_SOCIAL_TIKTOK=

# Cola de correos (sobrescribe QUEUE_* solo para mail-service)
MAIL_QUEUE_ENABLED=true
MAIL_QUEUE_CONCURRENCY=5
MAIL_QUEUE_ATTEMPTS=3
MAIL_QUEUE_BACKOFF_MS=5000

# Firebase Storage (solo si STORAGE_DRIVER=firebase)
# FIREBASE_PROJECT_ID=
# FIREBASE_STORAGE_BUCKET=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Legacy uploader (a reemplazar por storage-service)
UPLOADER_URL=http://localhost:8001
AI_ENGINE_URL=http://localhost:3008
AI_ENGINE_API_KEY=nm-ai-dev-key-change-in-production
INVOICING_SERVICE_URL=http://localhost:3009
INVOICING_API_KEY=nm-invoicing-dev-key-change-in-production

# ── WooCommerce ───────────────────────────────────────────────────────────────
WOOCOMMERCE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=

# Usuario del sistema para movimientos de inventario en pedidos web (opcional)
ECOMMERCE_SYSTEM_USER_ID=
# Tenant del storefront nm-ecommerce (clientes web se registran en este tenant)
ECOMMERCE_TENANT_ID=
