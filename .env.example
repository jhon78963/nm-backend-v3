# =============================================================================
# .env.example — nm-services NestJS Monorepo
# Copia a .env y ajusta los valores antes de correr los servicios.
# =============================================================================

# ── Entorno ──────────────────────────────────────────────────────────────────
NODE_ENV=development
FRONTEND_URL=http://localhost:4200

# ── Base de datos ─────────────────────────────────────────────────────────────
POSTGRES_DB=nm_services
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_PORT=5433
DATABASE_URL=postgresql://postgres:password@localhost:5433/nm_services

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generar con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CAMBIA_ESTO_POR_UN_SECRET_DE_64_CHARS_MINIMO
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=CAMBIA_ESTE_TAMBIEN_POR_UN_SECRET_DIFERENTE_64_CHARS
JWT_REFRESH_EXPIRES_IN=7d

# ── Rate Limiting ─────────────────────────────────────────────────────────────
THROTTLE_TTL=60000
THROTTLE_LIMIT=120

# ── Puertos internos (Docker usa estos para enrutar entre servicios) ──────────
GATEWAY_PORT=3000
AUTH_SERVICE_URL=http://localhost:3001
CATALOG_SERVICE_URL=http://localhost:3002
INVENTORY_SERVICE_URL=http://localhost:3003
POS_SERVICE_URL=http://localhost:3004
FINANCE_SERVICE_URL=http://localhost:3005
HR_SERVICE_URL=http://localhost:3006
REPORT_SERVICE_URL=http://localhost:3007

# ── SUNAT / Greenter (proxy al nm-backend legacy durante transición) ──────────
SUNAT_BACKEND_URL=http://localhost:8000
SUNAT_BACKEND_API_KEY=

# ── Integraciones externas ────────────────────────────────────────────────────
UPLOADER_URL=http://localhost:8001
AI_ENGINE_URL=http://localhost:8002

# ── WooCommerce ───────────────────────────────────────────────────────────────
WOOCOMMERCE_URL=
WOOCOMMERCE_CONSUMER_KEY=
WOOCOMMERCE_CONSUMER_SECRET=
