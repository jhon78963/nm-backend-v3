APP_NAME="NM Invoicing Service"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:3009

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=nm_services
DB_USERNAME=postgres
DB_PASSWORD=password

# ── SUNAT / Greenter ──────────────────────────────────────────────────────────
# Modo: beta | homologacion | produccion
SUNAT_MODE=beta

# Emisor
SUNAT_RUC=
SUNAT_RAZON_SOCIAL=
SUNAT_NOMBRE_COMERCIAL=

# Credenciales SOL (alias legacy: SUNAT_USER → SUNAT_SOL_USER, SUNAT_PASSWORD → SUNAT_SOL_PASS)
SUNAT_SOL_USER=MODDATOS
SUNAT_SOL_PASS=MODDATOS

# Certificado digital — usar una de las dos estrategias:
#   SUNAT_CERT_PATH     → ruta absoluta al .pem en el servidor
#   SUNAT_CERT_CONTENT  → contenido del .pem en Base64 (recomendado en CI/CD)
SUNAT_CERT_PATH=
SUNAT_CERT_CONTENT=

# Dirección fiscal del emisor
SUNAT_UBIGEO=150101
SUNAT_DEPARTAMENTO=LIMA
SUNAT_PROVINCIA=LIMA
SUNAT_DISTRITO=LIMA
SUNAT_DIRECCION=-
SUNAT_CODIGO_PAIS=PE

# ── Token apis.net.pe (consulta DNI/RUC) ─────────────────────────────────────
SUNAT_TOKEN=

# ── Autenticación inter-servicio ──────────────────────────────────────────────
INVOICING_API_KEY=nm-invoicing-dev-key-change-in-production
