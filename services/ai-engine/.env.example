# Application
APP_NAME=Novedades Maritex AI
ENVIRONMENT=local

# Database — misma instancia que nm-backend (Laravel usa pgsql por defecto)
DATABASE_URL=postgresql+psycopg2://username:password@127.0.0.1:5432/nm_database

# Security — clave que el gateway NestJS enviará en el header X-API-Key
API_KEY=nm-ai-dev-key-change-in-production

# CORS — orígenes permitidos (gateway NestJS en local: 3000, Swagger UI: 8000)
# En producción reemplazar con la URL real del gateway
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ML training thresholds (optional)
MIN_DEMAND_HISTORY_DAYS=30
MIN_DEMAND_TOTAL_SALES=5
MIN_PRICE_TRAINING_ROWS=10
