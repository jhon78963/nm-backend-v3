# Application
APP_NAME=Novedades Maritex AI
ENVIRONMENT=local

# Database — misma instancia PostgreSQL del monorepo NestJS
# Local (fuera de Docker): postgresql+psycopg2://postgres:password@127.0.0.1:5433/nm_services
# Docker (red interna):    postgresql+psycopg2://postgres:password@postgres:5432/nm_services
DATABASE_URL=postgresql+psycopg2://postgres:password@postgres:5432/nm_services

# Security — clave que el gateway NestJS enviará en el header X-API-Key
API_KEY=nm-ai-dev-key-change-in-production

# CORS — orígenes permitidos (gateway NestJS: 3000, servicio expuesto: 3008)
CORS_ORIGINS=["http://localhost:3000","http://localhost:3008"]

# ML training thresholds (optional)
MIN_DEMAND_HISTORY_DAYS=30
MIN_DEMAND_TOTAL_SALES=5
MIN_PRICE_TRAINING_ROWS=10
