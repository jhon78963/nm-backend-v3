    "/customers/pos-search": {
      "get": {
        "operationId": "CustomersController_searchForPos",
        "summary": "Buscar o registrar cliente por DNI/RUC para el POS",
        "description": "Busca en BD local; si no existe consulta RENIEC/SUNAT (apis.net.pe) y crea el cliente.",
        "parameters": [
          {
            "name": "q",
            "required": true,
            "in": "query",
            "description": "DNI (8 dígitos) o RUC (11 dígitos)",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Cliente encontrado o creado"
          },
          "404": {
            "description": "Documento no encontrado"
          },
          "503": {
            "description": "Servicio SUNAT/RENIEC no disponible"
          }
        },
        "tags": [
          "Customers"
        ],
        "security": [
          {
            "bearer": []
          }
        ]
      }
    },
