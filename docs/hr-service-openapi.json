  "info": {
    "title": "Novedades Maritex — HR Service",
    "description": "API de Recursos Humanos: gestión de equipos de trabajo, asistencia diaria, pagos de personal, clientes y proveedores del almacén.",
    "version": "1.0",
    "contact": {}
  },
  "tags": [
    {
      "name": "Teams",
      "description": "Personal de almacén"
    },
    {
      "name": "Attendance",
      "description": "Registro de asistencia"
    },
    {
      "name": "Payments",
      "description": "Pagos y adelantos de personal"
    },
    {
      "name": "Customers",
      "description": "Clientes"
    },
    {
      "name": "Vendors",
      "description": "Proveedores"
    }
  ],
  "servers": [],
  "components": {
    "securitySchemes": {
      "access-token": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http",
        "in": "header"
      }
    },
    "schemas": {
      "CreateTeamDto": {
        "type": "object",
        "properties": {
          "dni": {
            "type": "string",
            "example": "12345678",
            "description": "DNI del trabajador"
          },
          "name": {
            "type": "string",
            "example": "Juan"
          },
          "surname": {
            "type": "string",
            "example": "Pérez García"
          },
          "salary": {
            "type": "number",
            "description": "Salario mensual en soles",
            "minimum": 0
          },
          "warehouseId": {
            "type": "string",
            "description": "ID del almacén al que pertenece"
          },
          "userId": {
            "type": "string",
            "description": "ID del usuario vinculado (si tiene acceso al sistema)"
          }
        },
        "required": [
          "dni",
          "name",
          "surname",
          "salary",
          "warehouseId"
        ]
      },
      "UpsertCustomerDto": {
        "type": "object",
        "properties": {
          "dni": {
            "type": "string",
            "example": "74935446"
          },
          "name": {
            "type": "string",
            "example": "Anali Saraeli"
          },
          "surname": {
            "type": "string",
            "example": "Trujillo Cardenas"
          }
        },
        "required": [
          "dni",
          "name",
          "surname"
        ]
      },
      "UpdateCustomerDto": {
