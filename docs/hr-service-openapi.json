{
  "openapi": "3.0.0",
  "paths": {
    "/teams": {
      "get": {
        "operationId": "TeamsController_findAll",
        "summary": "Listar personal del almacén",
        "description": "Retorna todos los miembros activos del almacén del usuario autenticado, incluyendo el usuario vinculado (si existe) y conteo de asistencias y pagos.",
        "parameters": [
          {
            "name": "search",
            "required": false,
            "in": "query",
            "description": "Buscar por nombre, apellido o DNI",
            "schema": {}
          },
          {
            "name": "limit",
            "required": false,
            "in": "query",
            "schema": {
              "example": "10"
            }
          },
          {
            "name": "page",
            "required": false,
            "in": "query",
            "schema": {
              "example": "1"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Lista de miembros del equipo",
            "content": {
              "application/json": {
                "schema": {
                  "example": [
                    {
                      "id": "uuid",
                      "dni": "12345678",
                      "name": "Juan",
                      "surname": "Pérez",
                      "salary": 1200,
                      "warehouseId": "uuid",
                      "user": {
                        "id": "uuid",
                        "username": "jperez",
                        "email": "j@nm.com"
                      },
                      "_count": {
                        "attendances": 22,
                        "payments": 3
                      }
                    }
                  ]
                }
              }
            }
          },
          "401": {
            "description": "No autorizado — Bearer token requerido"
          }
        },
        "tags": [
          "Teams"
        ],
        "security": [
          {
            "access-token": []
          }
        ]
      },
      "post": {
        "operationId": "TeamsController_create",
        "summary": "Registrar nuevo miembro del equipo",
        "description": "Crea un nuevo trabajador en el almacén. El DNI debe ser único por almacén.",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTeamDto"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Miembro creado exitosamente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateTeamDto"
                }
              }
            }
          },
          "400": {
            "description": "Datos de entrada inválidos"
          },
          "401": {
            "description": "No autorizado"
          },
          "409": {
            "description": "Ya existe un miembro con ese DNI en el almacén"
          }
        },
        "tags": [
          "Teams"
        ],
        "security": [
          {
            "access-token": []
          }
        ]
      }
    },
    "/teams/{id}": {
      "get": {
        "operationId": "TeamsController_findById",
        "summary": "Obtener un miembro del equipo por ID",
        "description": "Incluye las últimas 30 asistencias y los últimos 10 pagos del miembro.",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "UUID del miembro del equipo",
            "schema": {
              "example": "a1b2c3d4-...",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Miembro del equipo encontrado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateTeamDto"
                }
              }
            }
          },
          "401": {
            "description": "No autorizado"
          },
          "404": {
            "description": "Miembro del equipo no encontrado"
          }
        },
        "tags": [
          "Teams"
        ],
        "security": [
          {
            "access-token": []
          }
        ]
      },
      "patch": {
        "operationId": "TeamsController_update",
        "summary": "Actualizar datos del miembro del equipo",
        "description": "Actualización parcial — solo los campos enviados se modifican.",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "UUID del miembro",
            "schema": {
              "example": "a1b2c3d4-...",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "description": "Campos a actualizar (todos opcionales en PATCH)",
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTeamDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Miembro actualizado",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateTeamDto"
                }
              }
            }
          },
          "401": {
            "description": "No autorizado"
          },
          "404": {
            "description": "Miembro del equipo no encontrado"
          }
        },
        "tags": [
          "Teams"
        ],
        "security": [
          {
            "access-token": []
          }
        ]
      },
      "delete": {
        "operationId": "TeamsController_remove",
        "summary": "Dar de baja a un miembro del equipo",
        "description": "Soft delete — marca el registro como eliminado sin borrar de la base de datos.",
        "parameters": [
          {
            "name": "id",
            "required": true,
            "in": "path",
            "description": "UUID del miembro",
            "schema": {
              "example": "a1b2c3d4-...",
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Miembro eliminado (soft delete)"
          },
          "401": {
            "description": "No autorizado"
          },
          "404": {
            "description": "Miembro del equipo no encontrado"
          }
        },
        "tags": [
          "Teams"
        ],
        "security": [
          {
            "access-token": []
          }
        ]
      }
    },
