    "finance-service": {
      "type": "application",
      "root": "apps/finance-service",
      "entryFile": "main",
      "sourceRoot": "apps/finance-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/finance-service/tsconfig.app.json"
      }
    },
    "hr-service": {
      "type": "application",
      "root": "apps/hr-service",
      "entryFile": "main",
      "sourceRoot": "apps/hr-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/hr-service/tsconfig.app.json"
      }
    },
    "report-service": {
      "type": "application",
      "root": "apps/report-service",
