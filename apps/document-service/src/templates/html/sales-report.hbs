<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script src="https://cdn.tailwindcss.com"></script>
  <title>{{title}}</title>
  <style>
    @page { margin: 16mm; }
    body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
  </style>
</head>
<body class="bg-white text-slate-800 text-sm font-sans">
  <header class="border-b border-slate-200 pb-4 mb-6">
    <div class="flex items-start justify-between">
      <div>
        <h1 class="text-2xl font-bold text-slate-900">{{title}}</h1>
        <p class="text-slate-500 mt-1">{{subtitle}}</p>
      </div>
      <div class="text-right text-xs text-slate-400">
        <p>Generado: {{generatedAt}}</p>
        <p class="mt-1">Solo ventas completadas</p>
      </div>
    </div>
  </header>

  <section class="grid grid-cols-3 gap-3 mb-6">
    <div class="rounded-lg bg-indigo-50 border border-indigo-100 p-3">
      <p class="text-xs text-indigo-600 font-medium uppercase tracking-wide">Total vendido</p>
      <p class="text-xl font-bold text-indigo-900 mt-1">S/ {{summary.totalAmount}}</p>
    </div>
    <div class="rounded-lg bg-emerald-50 border border-emerald-100 p-3">
      <p class="text-xs text-emerald-600 font-medium uppercase tracking-wide">Transacciones</p>
      <p class="text-xl font-bold text-emerald-900 mt-1">{{summary.transactionCount}}</p>
    </div>
    <div class="rounded-lg bg-amber-50 border border-amber-100 p-3">
      <p class="text-xs text-amber-600 font-medium uppercase tracking-wide">Artículos vendidos</p>
      <p class="text-xl font-bold text-amber-900 mt-1">{{summary.itemsSold}}</p>
    </div>
    <div class="rounded-lg bg-slate-50 border border-slate-200 p-3">
      <p class="text-xs text-slate-500 font-medium uppercase tracking-wide">Ticket promedio</p>
      <p class="text-lg font-semibold text-slate-800 mt-1">S/ {{summary.averageTicket}}</p>
    </div>
    <div class="rounded-lg bg-slate-50 border border-slate-200 p-3">
      <p class="text-xs text-slate-500 font-medium uppercase tracking-wide">Efectivo</p>
      <p class="text-lg font-semibold text-slate-800 mt-1">S/ {{summary.cash}}</p>
    </div>
    <div class="rounded-lg bg-slate-50 border border-slate-200 p-3">
      <p class="text-xs text-slate-500 font-medium uppercase tracking-wide">Digital</p>
      <p class="text-lg font-semibold text-slate-800 mt-1">S/ {{summary.digital}}</p>
    </div>
  </section>

  {{#if summary.averageDaily}}
  <section class="grid grid-cols-2 gap-3 mb-6">
    <div class="rounded-lg bg-slate-50 border border-slate-200 p-3">
      <p class="text-xs text-slate-500 font-medium uppercase tracking-wide">Promedio diario</p>
      <p class="text-lg font-semibold text-slate-800 mt-1">S/ {{summary.averageDaily}}</p>
    </div>
    <div class="rounded-lg bg-slate-50 border border-slate-200 p-3">
      <p class="text-xs text-slate-500 font-medium uppercase tracking-wide">Días con ventas</p>
      <p class="text-lg font-semibold text-slate-800 mt-1">{{summary.daysWithSales}}{{#if summary.daysInRange}} / {{summary.daysInRange}}{{/if}}</p>
    </div>
  </section>
  {{/if}}

  <section class="mb-6">
    <h2 class="text-sm font-semibold text-slate-700 uppercase tracking-wide mb-2">Desglose por método de pago</h2>
    <table class="w-full border-collapse text-xs">
      <thead>
        <tr class="bg-slate-100 text-slate-600">
          <th class="text-left p-2 border border-slate-200">Método</th>
          <th class="text-right p-2 border border-slate-200">Cantidad</th>
          <th class="text-right p-2 border border-slate-200">Monto</th>
        </tr>
      </thead>
      <tbody>
        {{#each paymentBreakdown}}
        <tr class="even:bg-slate-50">
          <td class="p-2 border border-slate-200">{{label}}</td>
          <td class="p-2 border border-slate-200 text-right">{{count}}</td>
          <td class="p-2 border border-slate-200 text-right font-medium">S/ {{amount}}</td>
        </tr>
        {{/each}}
        {{#unless paymentBreakdown.length}}
        <tr>
          <td colspan="3" class="p-3 border border-slate-200 text-center text-slate-400">Sin movimientos</td>
        </tr>
        {{/unless}}
      </tbody>
    </table>
  </section>

  {{#if isDaily}}
  <section>
    <h2 class="text-sm font-semibold text-slate-700 uppercase tracking-wide mb-2">Detalle de transacciones</h2>
    <table class="w-full border-collapse text-xs">
      <thead>
        <tr class="bg-slate-100 text-slate-600">
          <th class="text-left p-2 border border-slate-200">Hora</th>
          <th class="text-left p-2 border border-slate-200">Código</th>
          <th class="text-left p-2 border border-slate-200">Cliente</th>
          <th class="text-right p-2 border border-slate-200">Ítems</th>
          <th class="text-left p-2 border border-slate-200">Pago</th>
          <th class="text-right p-2 border border-slate-200">Total</th>
        </tr>
      </thead>
      <tbody>
        {{#each transactions}}
        <tr class="even:bg-slate-50">
          <td class="p-2 border border-slate-200">{{time}}</td>
          <td class="p-2 border border-slate-200 font-mono">{{code}}</td>
          <td class="p-2 border border-slate-200">{{customer}}</td>
          <td class="p-2 border border-slate-200 text-right">{{itemsCount}}</td>
          <td class="p-2 border border-slate-200">{{paymentLabel}}</td>
          <td class="p-2 border border-slate-200 text-right font-medium">S/ {{totalAmount}}</td>
        </tr>
        {{/each}}
        {{#unless transactions.length}}
        <tr>
          <td colspan="6" class="p-3 border border-slate-200 text-center text-slate-400">Sin ventas en este período</td>
        </tr>
        {{/unless}}
      </tbody>
    </table>
  </section>
  {{else}}
  <section>
    <h2 class="text-sm font-semibold text-slate-700 uppercase tracking-wide mb-2">Desglose diario</h2>
    <table class="w-full border-collapse text-xs">
      <thead>
        <tr class="bg-slate-100 text-slate-600">
          <th class="text-left p-2 border border-slate-200">Fecha</th>
          <th class="text-left p-2 border border-slate-200">Día</th>
          <th class="text-right p-2 border border-slate-200">Transacciones</th>
          <th class="text-right p-2 border border-slate-200">Efectivo</th>
          <th class="text-right p-2 border border-slate-200">Digital</th>
          <th class="text-right p-2 border border-slate-200">Total</th>
        </tr>
      </thead>
      <tbody>
        {{#each dailyBreakdown}}
        <tr class="even:bg-slate-50 {{#unless transactions}}text-slate-400{{/unless}}">
          <td class="p-2 border border-slate-200">{{date}}</td>
          <td class="p-2 border border-slate-200 capitalize">{{dayOfWeek}}</td>
          <td class="p-2 border border-slate-200 text-right">{{transactions}}</td>
          <td class="p-2 border border-slate-200 text-right">S/ {{cash}}</td>
          <td class="p-2 border border-slate-200 text-right">S/ {{digital}}</td>
          <td class="p-2 border border-slate-200 text-right font-medium">S/ {{total}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </section>
  {{/if}}
</body>
</html>
