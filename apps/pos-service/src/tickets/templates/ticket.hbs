<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>{{title}}</title>
    <style>
        @page { margin: 0; size: 80mm auto; }
        * { box-sizing: border-box; }
        body {
            font-family: 'Arial Narrow', Arial, sans-serif;
            font-size: 9.5px;
            margin: 3mm 3mm 6mm 3mm;
            color: #000;
            background: #fff;
            -webkit-print-color-adjust: exact;
            print-color-adjust: exact;
        }
        .tc { text-align: center; }
        .tr { text-align: right; }
        .tl { text-align: left; }
        .bold { font-weight: bold; }
        .small { font-size: 8px; }
        .line-solid { border: none; border-top: 1.5px solid #000; margin: 4px 0; }
        .line-dashed { border: none; border-top: 1.5px dashed #000; margin: 4px 0; }
        .header { text-align: center; padding-bottom: 4px; }
        .logo-img {
            width: 150px; max-width: 40mm; max-height: 18mm; height: auto;
            display: block; margin: 0 auto 4px auto; object-fit: contain;
        }
        @media print {
            .logo-img { filter: grayscale(100%) brightness(0); -webkit-filter: grayscale(100%) brightness(0); }
            html, body { width: 80mm !important; max-width: 80mm !important; margin: 0 !important; }
        }
        .company-name { font-size: 14px; font-weight: 900; letter-spacing: 0.5px; text-transform: uppercase; }
        .company-legal { font-size: 8px; margin-top: 1px; }
        .header-addr { font-size: 8px; margin-top: 3px; line-height: 1.5; }
        .header-contact { font-size: 8px; margin-top: 2px; line-height: 1.6; }
        .social-line { font-size: 7.5px; margin-top: 1px; }
        .doc-box { border: 2px solid #000; border-radius: 3px; text-align: center; padding: 5px 6px; margin: 5px 0; }
        .doc-box .ruc-label { font-size: 9px; font-weight: bold; margin-bottom: 2px; }
        .doc-box .doc-type { font-size: 11px; font-weight: 900; text-transform: uppercase; letter-spacing: 0.5px; }
        .doc-box .doc-num { font-size: 13px; font-weight: 900; margin-top: 3px; letter-spacing: 1.5px; }
        .client-section { font-size: 9px; margin: 4px 0; }
        .client-section .row { display: flex; justify-content: space-between; margin-top: 2px; }
        .client-section .lbl { font-weight: bold; white-space: nowrap; margin-right: 4px; }
        .client-section .val { flex: 1; word-break: break-word; }
        .items-table { width: 100%; border-collapse: collapse; margin: 4px 0; }
        .items-table thead th {
            font-size: 8.5px; font-weight: 900; border-top: 1.5px solid #000;
            border-bottom: 1.5px solid #000; padding: 3px 2px; text-transform: uppercase;
        }
        .items-table tbody td { font-size: 9px; padding: 3px 2px; vertical-align: top; border-bottom: 1px dashed #bbb; }
        .items-table tbody tr:last-child td { border-bottom: none; }
        .totals-table { width: 100%; border-collapse: collapse; margin-top: 2px; }
        .totals-table td { font-size: 9px; padding: 2px; }
        .totals-table td:first-child { text-align: right; padding-right: 6px; }
        .totals-table td:last-child { text-align: right; white-space: nowrap; min-width: 18mm; }
        .totals-table .grand-total td { font-size: 12px; font-weight: 900; border-top: 1.5px solid #000; padding-top: 4px; }
        .amount-words { font-size: 8px; font-weight: bold; text-align: center; margin: 4px 0; line-height: 1.4; }
        .payments-section { font-size: 8.5px; margin: 3px 0; }
        .payments-section .pay-row { display: flex; justify-content: space-between; padding: 1px 0; }
        .qr-area { text-align: center; margin: 5px auto 3px auto; }
        .qr-area img { width: 38mm; height: 38mm; display: block; margin: 0 auto; }
        .qr-hash { font-size: 6.5px; color: #444; word-break: break-all; text-align: center; margin: 2px 0 4px 0; line-height: 1.4; }
        .footer { font-size: 8px; text-align: center; margin-top: 6px; line-height: 1.6; }
    </style>
</head>
<body>
    <div class="header">
        {{#if logoSrc}}
            <img class="logo-img" src="{{logoSrc}}" alt="{{tradeName}}" width="150">
        {{/if}}
        <div class="company-name">{{tradeName}}</div>
        {{#if showLegalName}}
            <div class="company-legal">{{legalName}}</div>
        {{/if}}
        <div class="header-addr">
            {{address}}<br>
            {{district}}, {{province}}, {{department}}
        </div>
        {{#if hasContact}}
            <div class="header-contact">
                {{#if phone}}Tel: {{phone}}{{/if}}
                {{#if phone}}{{#if emailHtml}}&nbsp;|&nbsp;{{/if}}{{/if}}
                {{#if emailHtml}}{{{emailHtml}}}{{/if}}
            </div>
        {{/if}}
        {{#if website}}<div class="social-line">{{website}}</div>{{/if}}
        {{#if hasSocial}}
            <div class="social-line">
                {{#if facebook}}FB: {{facebook}}{{/if}}
                {{#if instagram}}{{#if facebook}}&nbsp;·&nbsp;{{/if}}IG: {{instagram}}{{/if}}
                {{#if tiktok}}{{#if facebook}}&nbsp;·&nbsp;{{else}}{{#if instagram}}&nbsp;·&nbsp;{{/if}}{{/if}}TK: {{tiktok}}{{/if}}
            </div>
        {{/if}}
    </div>

    <hr class="line-solid">

    <div class="doc-box">
        {{#if isFiscal}}{{#if ruc}}<div class="ruc-label">RUC: {{ruc}}</div>{{/if}}{{/if}}
        {{#if isFactura}}
            <div class="doc-type">Factura Electrónica</div>
        {{else}}{{#if isBoleta}}
            <div class="doc-type">Boleta de Venta Electrónica</div>
        {{else}}
            <div class="doc-type">Ticket de Venta</div>
        {{/if}}{{/if}}
        <div class="doc-num">{{fullNumber}}</div>
    </div>

    <div class="client-section">
        <div class="row">
            <span class="lbl">FECHA EMISIÓN:</span>
            <span class="val">{{issuedAt}}</span>
        </div>
        <div class="row">
            <span class="lbl">CONDICIÓN PAGO:</span>
            <span class="val">CONTADO</span>
        </div>
        {{#if hasCustomer}}
            <div class="row">
                <span class="lbl">{{customerLabel}}</span>
                <span class="val">{{customerName}}</span>
            </div>
            <div class="row">
                <span class="lbl">{{customerDocType}}:</span>
                <span class="val">{{customerDocNumber}}</span>
            </div>
        {{else}}
            <div class="row">
                <span class="lbl">CLIENTE:</span>
                <span class="val">CLIENTES VARIOS</span>
            </div>
            {{#if showDefaultDni}}
                <div class="row">
                    <span class="lbl">DNI:</span>
                    <span class="val">00000000</span>
                </div>
            {{/if}}
        {{/if}}
        <div class="row">
            <span class="lbl">MONEDA:</span>
            <span class="val">SOLES (PEN)</span>
        </div>
    </div>

    <hr class="line-dashed">

    <table class="items-table">
        <thead>
            <tr>
                <th class="tc" style="width:10%">CANT.</th>
                <th class="tl" style="width:55%">DESCRIPCIÓN</th>
                <th class="tr" style="width:16%">P.UNIT.</th>
                <th class="tr" style="width:19%">IMPORTE</th>
            </tr>
        </thead>
        <tbody>
            {{#each details}}
            <tr>
                <td class="tc bold">{{quantity}}</td>
                <td class="tl">
                    <span class="bold">{{productName}}</span><br>
                    <span class="small">T:{{sizeName}} C:{{colorName}}</span>
                </td>
                <td class="tr">{{unitPrice}}</td>
                <td class="tr bold">{{lineTotal}}</td>
            </tr>
            {{/each}}
        </tbody>
    </table>

    <hr class="line-dashed">

    <table class="totals-table">
        {{#if isFiscal}}
            <tr><td>OP. GRAVADAS:</td><td>S/ {{taxableBase}}</td></tr>
            <tr><td>OP. EXONERADAS:</td><td>S/ 0.00</td></tr>
            <tr><td>OP. INAFECTAS:</td><td>S/ 0.00</td></tr>
            <tr><td>OP. GRATUITAS:</td><td>S/ 0.00</td></tr>
            <tr><td>SUBTOTAL:</td><td>S/ {{taxableBase}}</td></tr>
            <tr><td>DESCUENTOS:</td><td>S/ 0.00</td></tr>
            <tr><td>IGV 18.0%:</td><td>S/ {{igv}}</td></tr>
            <tr><td>ICBPER:</td><td>S/ 0.00</td></tr>
            <tr><td>ADELANTOS:</td><td>S/ 0.00</td></tr>
        {{/if}}
        <tr class="grand-total">
            <td class="bold">TOTAL:</td>
            <td class="bold">S/ {{total}}</td>
        </tr>
    </table>

    <hr class="line-dashed">

    <div class="amount-words">SON: {{amountInWords}}</div>

    <hr class="line-dashed">

    <div class="payments-section">
        {{#if hasPayments}}
            <div class="bold" style="margin-bottom:2px;">FORMA DE PAGO:</div>
            {{#each payments}}
                <div class="pay-row">
                    <span>{{label}}</span>
                    <span class="bold">S/ {{amount}}</span>
                </div>
            {{/each}}
        {{else}}
            <div class="pay-row">
                <span class="bold">FORMA DE PAGO:</span>
                <span>{{fallbackPaymentLabel}}</span>
            </div>
        {{/if}}
    </div>

    <hr class="line-solid">

    {{#if isFiscal}}{{#if qrSvg}}
        <div class="qr-area">
            <img src="{{qrSvg}}" alt="QR SUNAT">
        </div>
        {{#if xmlHash}}
            <div class="qr-hash"><strong>Resumen:</strong> {{xmlHash}}</div>
        {{/if}}
    {{/if}}{{/if}}

    <div class="footer">
        {{#if isFiscal}}
            <strong>Representación Impresa de {{#if isFactura}}FACTURA{{else}}BOLETA DE VENTA{{/if}} ELECTRÓNICA</strong><br>
            Autorizado mediante Res. N° 014-005-0001495/SUNAT<br>
            Consulte su comprobante en: <em>ww1.sunat.gob.pe</em>
        {{else}}
            <strong>*** TICKET INTERNO — NO ES COMP. DE PAGO ***</strong>
        {{/if}}
        <br><br>
        <strong>¡GRACIAS POR SU PREFERENCIA!</strong><br>
        <span class="small">{{footerNote}}</span>
    </div>
</body>
</html>
